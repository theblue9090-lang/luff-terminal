# -----------------------------------------------------------------------------
# LUFF·SNIPER environment configuration
# Copy to `.env.local` and fill in. All keys are optional — the app ships with
# working defaults — but a paid RPC is STRONGLY recommended for real sniping.
# -----------------------------------------------------------------------------

# Privy application id (default is baked in). Get yours at https://dashboard.privy.io
VITE_PRIVY_APP_ID=cmrpmbbsc00f50djv46ahai5g

# Solana mainnet RPC. Defaults to the free PublicNode endpoint
# (https://solana-rpc.publicnode.com) which accepts transaction sends out of the
# box. It is rate-limited — use a paid node (Helius / QuickNode / Triton) so your
# buys land before other snipers.
# Example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# VITE_SOLANA_RPC=https://solana-rpc.publicnode.com

# Optional dedicated WebSocket RPC (defaults to deriving from VITE_SOLANA_RPC).
# VITE_SOLANA_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional: PumpPortal API key. Not required — new-token detection and trading
# work without it. Only enables the real-time per-token TRADE stream for faster
# position PnL (metered ~0.01 SOL / 10k events). Without it, position PnL is
# updated by polling DexScreener every ~5s, which is free and needs no key.
# VITE_PUMPPORTAL_API_KEY=your-pumpportal-api-key

# Advanced overrides (leave unset unless you run your own proxy):
# VITE_PUMPPORTAL_WS=wss://pumpportal.fun/api/data
# VITE_PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local
# VITE_DEXSCREENER_BASE=https://api.dexscreener.com
